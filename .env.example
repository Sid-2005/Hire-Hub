# ==============================================================================
# HIREHUB BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked <...> before starting the application.
# 3. For cloud deployment: paste each key/value into your host's dashboard
#    (Render → Environment, Railway → Variables, etc.). Do NOT upload .env.
#
# REQUIRED variables have no default in application.properties.
# Spring Boot will refuse to start if any REQUIRED variable is missing.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# [OPTIONAL] Defaults to 8080. Cloud platforms (Render, Railway) inject PORT
# automatically — you usually do not need to set this in production.
PORT=8080

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# [REQUIRED] JDBC connection URL.
# Local:  jdbc:postgresql://localhost:5432/<your_db_name>
# Cloud:  jdbc:postgresql://<host>:<port>/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/<your_db_name>

# [REQUIRED] Database login credentials.
DB_USERNAME=<your_db_username>
DB_PASSWORD=<your_db_password>

# ── JWT Authentication ─────────────────────────────────────────────────────────
# [REQUIRED] Base64-encoded HMAC-SHA256 signing key (minimum 256 bits / 32 bytes).
# Generate a secure key with one of:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<base64_encoded_256bit_secret>

# [OPTIONAL] Token lifetime in milliseconds. Defaults to 86400000 (24 hours).
JWT_EXPIRATION=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Comma-separated list of frontend origins allowed to call the API.
# Supports wildcard patterns (e.g. https://*.vercel.app).
# Local:      http://localhost:5173,http://localhost:3000
# Production: https://<your-frontend-domain>
CORS_ALLOWED_ORIGINS=<your_frontend_origin>

# ── JPA / Hibernate ───────────────────────────────────────────────────────────
# [REQUIRED] Hibernate schema strategy.
# Local/staging: update  (auto-creates and migrates tables)
# Production:    validate (schema must be managed externally, e.g. via Flyway)
JPA_DDL_AUTO=update

# [REQUIRED] Log SQL queries to stdout.
# Local:      true
# Production: false  (reduces noise, avoids leaking query structure in logs)
SHOW_SQL=false
