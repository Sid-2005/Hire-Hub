# ==============================================================================
# HIREHUB FRONTEND — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# 1. Copy this file:  cp .env.example .env  (inside the frontend/ directory)
# 2. Fill in every value marked <...>.
# 3. Cloud deployment: set variables in Vercel / Netlify / Cloudflare dashboard
#    BEFORE running the build. Vite bakes VITE_* values in at build time.
#
# ⚠  Only variables prefixed with VITE_ are accessible in browser code.
#    All other variables are available to vite.config.js only (Node.js side).
# ==============================================================================

# ── API Base URL ──────────────────────────────────────────────────────────────
# [REQUIRED] The base URL Axios uses for every API call.
#
# Local development:
#   VITE_API_BASE_URL=/api
#   (Vite dev server proxies /api/* → VITE_BACKEND_TARGET)
#
# Production / Cloud:
#   VITE_API_BASE_URL=https://<your-backend-domain>/api
#   (must include the /api path suffix — backend controllers are mounted there)
#
# ⚠  Leaving this blank will throw a runtime error AND abort the production build.
VITE_API_BASE_URL=<your_backend_api_url_ending_in_/api>

# ── Dev server proxy target ───────────────────────────────────────────────────
# [LOCAL DEV ONLY] Where the Vite dev server forwards /api/* requests.
# Not used in production builds.
VITE_BACKEND_TARGET=http://localhost:8080

# ── Dev server port ───────────────────────────────────────────────────────────
# [LOCAL DEV ONLY] Port the Vite dev server listens on. Defaults to 5173.
PORT=5173
